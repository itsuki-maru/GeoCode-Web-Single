  },
  "devDependencies": {
    "@types/node": "^22.18.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^29.1.1",
    "leaflet": "1.9.3",
    "leaflet.markercluster": "1.5.3",
    "marked": "17.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vitest": "^4.1.11"
  }
