{
  "name": "geocode-web-frontend",
  "version": "1.13.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:template-js": "vitest run tests/template-js",
    "build-only": "vite build && node scripts/copy-vendor-assets.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "ace-builds": "^1.45.2",
    "axios": "^1.21.0",
    "htmlparser2": "10.0.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "marked": "17.0.6",
    "pinia": "^3.0.4",
    "qrcode": "1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "xss": "1.0.17"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "js-beautify": {
      "glob": "^14.0.4"
    },
    "editorconfig": {
      "minimatch": "^11.0.5"
    }
  }
}
